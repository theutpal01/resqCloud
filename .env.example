# Run node scripts/setupLocal.mjs from the repository root to create a private
# .env with random secrets and SQLite enabled. For manual setup, copy this file
# to .env and replace both REPLACE placeholders before starting the application.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEV_SEED_PASSWORD=REPLACE_WITH_A_DEVELOPMENT_PASSWORD

# AWS target: Aurora PostgreSQL express configuration with IAM database auth.
# setupLocal.mjs switches these settings to SQLite for local development.
DB_DIALECT=postgres
DATABASE_URL=postgres://resq_app@YOUR_AURORA_WRITER_ENDPOINT:5432/resqcloud
DB_SSL=true
# Combined RDS CA bundle and Amazon Trust Services root used by this Aurora endpoint.
DB_SSL_CA_PATH=/absolute/path/to/resCloud/.local-secrets/aurora-ca-bundle.pem
DB_IAM_AUTH=true
SQLITE_PATH=./resqcloud.sqlite

# Public browser configuration; rebuild the web app after changing these values.
# Never put private credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Set only for the local demo launcher; never enable demo shortcuts in production.
NEXT_PUBLIC_DEMO_MODE=false
# Optional: leave blank to use the coordinate list instead of interactive maps.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional Cognito integration. Leave blank for local development sign-in.
# App client IDs are public; this browser value must match COGNITO_CLIENT_ID below.
# Domain format: https://<domain>.auth.<AWS_REGION>.amazoncognito.com
# Register APP_ORIGIN/auth/callback as the callback URL.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=

# AWS showcase settings; use workload credentials or a local AWS profile.
# Leave service values blank only when using local development/test mode.
AWS_REGION=ap-southeast-2
# Optional local CLI profile; production uses the ECS task role instead.
AWS_PROFILE=
# Optional S3-compatible endpoint override; leave blank for AWS S3.
AWS_ENDPOINT=
S3_BUCKET=
SQS_QUEUE_URL=
SNS_TOPIC_ARN=

# Optional private CloudFront delivery. Use the distribution hostname without https://.
# Keep the RSA private key in an ignored local file; upload only its public key to CloudFront.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_PUBLIC_KEY_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

# Optional Playwright browser override. Export in the shell before test:e2e;
# playwright.config.ts does not load this file itself.
# BROWSER_EXECUTABLE=/absolute/path/to/chromium

# AWS database connections should use verified TLS (DB_SSL=true and the CA path).
# Production requires NODE_ENV=production, PostgreSQL, verified DB TLS,
# an HTTPS APP_ORIGIN, real database/JWT credentials and Cognito configuration.
# See docs/deployment.md and scripts/productionPreflight.mjs for release checks.
